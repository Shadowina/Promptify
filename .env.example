# Promptify Configuration Example
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file or credentials to source control.

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Spotify Developer API
# Create an app at: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify OAuth Redirect URI
# Must match exactly what is registered in your Spotify Developer Dashboard under "Redirect URIs".
# Note: Spotify requires loopback IP addresses (http://127.0.0.1:8501) rather than 'localhost'.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8501
